{$PRLS_ALLURE_HOST} {
	tls {$HARDEN_LLM_TLS_MODE}
	import security_headers
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
	header X-Frame-Options "DENY"
	basic_auth {
		{$PRLS_TESTS_BASIC_AUTH_USER} {$PRLS_TESTS_BASIC_AUTH_HASH}
	}
	request_body {
		max_size 64MB
	}
	reverse_proxy allure:3000
}
