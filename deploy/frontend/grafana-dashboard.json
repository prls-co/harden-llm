      "targets": [{"expr": "sum(rate(harden_llm_web_http_requests[5m])) by (route, outcome)", "legendFormat": "{{route}} {{outcome}}", "refId": "A"}],
      "title": "Web Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "harden-prometheus"},
