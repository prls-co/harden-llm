    {
      "datasource": {
        "type": "prometheus",
        "uid": "harden-prometheus"
      },
      "description": "Failed PRLS log and trace exports. Agent execution remains independent of this signal.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harden-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_log_records{exporter=~\"otlphttp/loki_prls_.*\"}[5m])) + sum by (exporter) (rate(otelcol_exporter_send_failed_spans{exporter=\"otlp/prls_laminar\"}[5m]))",
          "legendFormat": "{{exporter}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "PRLS exporter failures",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "harden-prometheus"
      },
      "description": "Bounded exporter queue utilization for the PRLS signal paths.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harden-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (exporter) (otelcol_exporter_queue_size{exporter=~\".*prls.*\"} / clamp_min(otelcol_exporter_queue_capacity{exporter=~\".*prls.*\"}, 1))",
          "legendFormat": "{{exporter}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "PRLS exporter queue utilization",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "prls",
