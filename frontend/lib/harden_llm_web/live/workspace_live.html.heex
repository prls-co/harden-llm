<Layouts.app flash={@flash} current_scope={@current_scope} current_identity={@current_identity}>
  <main id="workspace-page" class="studio-page mx-auto max-w-5xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-700">
          🧪 Trace Studio
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950">
          Shape one reliable call
        </h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-600">
          Configure a provider-neutral profile, validate structured output before it leaves the browser, and inspect redacted execution facts.
        </p>
      </div>
      <span
        id="backend-status"
        class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600"
      >
        {status_label(@backend_state)}
      </span>
    </div>

    <div
      :if={@loading?}
      id="workspace-loading"
      role="status"
      class="rounded-2xl border border-slate-200 bg-white p-8 text-slate-600"
    >
      Loading the canonical workspace…
    </div>

    <div
      :if={@backend_state == :unavailable}
      id="workspace-unavailable"
      role="alert"
      class="rounded-2xl border border-amber-300 bg-amber-50 p-6 text-amber-950"
    >
      The backend is unavailable. The console will remain online; refresh when the service recovers.
    </div>

    <.form
      :if={@backend_state == :ready}
      for={@form}
      id="run-form"
      phx-change="save-draft"
      phx-submit="run"
      class="contents"
    >
      <div :if={@backend_state == :ready} class="studio-stack">
        <section class="studio-stack">
          <section id="model-config" aria-label="LLM model config" class="studio-card p-0">
            <.live_component
              module={HardenLlmWeb.ProfileWidgetComponent}
              id="workspace-llm-widget"
              profiles={@profiles}
              model_catalog={host_model_catalog(@profiles)}
              selected_profile_id={@form[:selectedProfileId].value || ""}
              reasoning_effort={@form[:reasoningEffort].value || "lowest"}
              cache_mode={@form[:cacheMode].value || "cache"}
              model_id={@form[:modelId].value || ""}
              config_open={@ui["llmProfileConfigOpen"]}
              options_open={@ui["modelOptionsOpen"]}
              retry_open={@ui["retryRepairOpen"]}
              pricing_open={@ui["pricingOpen"]}
              fold_disabled={@ui_save_pending?}
              session_handle={@session_handle}
              bundle_upload={@uploads.profile_bundle}
              escalation_bundle_upload={@uploads.escalation_profile_bundle}
            />
          </section>

          <section aria-label="Input" class="ullm-widget ullm-input-widget">
            <div class="ullm-widget-header">
              <h2>Input</h2>
            </div>
            <.input
              field={@form[:userPrompt]}
              type="textarea"
              label="Prompt"
              rows="8"
              placeholder="Ask the selected model to produce a concise answer."
              class="ullm-input"
              phx-debounce="blur"
              required
              phx-hook="PromptShortcut"
              data-form-id="run-form"
            />
            <div class="ullm-options-fold">
              <button
                id="input-advanced-toggle"
                type="button"
                phx-click="toggle-ui"
                phx-value-name="inputAdvancedOpen"
                phx-value-open={if @ui["inputAdvancedOpen"], do: "false", else: "true"}
                aria-expanded={to_string(@ui["inputAdvancedOpen"])}
                disabled={@ui_save_pending?}
                class="ullm-btn ullm-options-summary"
              >Advanced input</button>
              <div :if={@ui["inputAdvancedOpen"]} id="advanced-input" class="ullm-options-body">
                <.input
                  field={@form[:systemPrompt]}
                  type="textarea"
                  label="System Prompt"
                  rows="3"
                  placeholder="Optional system instruction."
                  class="ullm-input"
                  phx-debounce="blur"
                />
                <.input
                  field={@form[:schemaShorthand]}
                  type="textarea"
                  label="Schema shorthand"
                  placeholder={~s({"answer":"string"})}
                  rows="4"
                  class="ullm-input ullm-input-mono"
                  phx-debounce="blur"
                />
                <div class="ullm-button-row ullm-button-row-end">
                  <button
                    id="generate-schema"
                    type="button"
                    phx-click="generate-schema"
                    disabled={String.trim(@form[:schemaShorthand].value || "") == ""}
                    class="ullm-btn"
                  >Generate JSON Schema</button>
                </div>
                <.input
                  field={@form[:schema]}
                  type="textarea"
                  label="Structured Output Schema"
                  rows="6"
                  placeholder={~s({"type":"object","properties":{"answer":{"type":"string"}}})}
                  class="ullm-input ullm-input-mono"
                  hint_id="schema-status"
                  hint={schema_status_text(@schema_check)}
                  hint_tone={if @schema_check.status == :error, do: "error", else: "neutral"}
                  aria-invalid={if @schema_check.status == :error, do: "true"}
                  phx-debounce="5000"
                  phx-hook="SchemaPending"
                  data-status-id="schema-status"
                  data-run-submit-id="run-submit"
                />
                <div class="ullm-button-row ullm-button-row-end">
                  <button
                    id="check-schema"
                    type="button"
                    phx-click="check-schema"
                    phx-hook="SchemaCheck"
                    data-form-id="run-form"
                    disabled={String.trim(@form[:schema].value || "") == ""}
                    class="ullm-btn"
                  >Check Schema</button>
                  <button
                    id="clear-schema"
                    type="button"
                    phx-click="clear-schema"
                    disabled={
                      String.trim(@form[:schemaShorthand].value || "") == "" and
                        String.trim(@form[:schema].value || "") == ""
                    }
                    class="ullm-btn"
                  >Clear Schema</button>
                </div>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <.input
                field={@form[:callType]}
                type="select"
                label="Response type"
                options={[{"Text", "text"}, {"Structured JSON", "structured"}]}
                phx-debounce="blur"
              />
              <.input
                field={@form[:structuredRepair]}
                type="checkbox"
                label="Structured repair"
                phx-debounce="blur"
              />
            </div>

            <div
              :if={@run_error}
              id="run-error"
              role="alert"
              class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900"
            >
              {@run_error}
            </div>
            <div class="ullm-button-row ullm-button-row-end">
              <button
                id="clear-prompt-fields"
                type="button"
                phx-click="clear-prompt"
                disabled={
                  String.trim(@form[:userPrompt].value || "") == "" and
                    String.trim(@form[:systemPrompt].value || "") == "" and
                    String.trim(@form[:schemaShorthand].value || "") == "" and
                    String.trim(@form[:schema].value || "") == ""
                }
                class="ullm-btn"
              >🧹 Clear Prompt Fields</button>
              <button
                id="run-submit"
                type="submit"
                formnovalidate
                disabled={run_disabled?(@form, @schema_check, @run_ref)}
                phx-disable-with="Running…"
                class="ullm-btn ullm-btn-primary"
              >
                {if @run_ref, do: "⏳ Running…", else: "Run Prompt"}
              </button>
            </div>
          </section>

          <aside class="studio-stack">
            <section
              id="run-result-panel"
              aria-label="Output"
              class="ullm-widget ullm-output-widget"
            >
              <div class="ullm-widget-header">
                <h2>Output</h2>
              </div>
              <div class="ullm-result-panel">
                <p :if={is_nil(@run_result)} class="ullm-empty-text">
                  Run a prompt to see the trace summary here.
                </p>
                <article
                  :if={@run_result}
                  class="ullm-run-output ullm-run-output-open"
                >
                  <div class="ullm-run-output-head">
                    <div class="ullm-run-output-label">
                      <span class="ullm-run-output-title">Latest output</span>
                      <span class="ullm-run-output-meta ullm-mono">
                        {output_meta(@run_result, @form.params, @profiles)}
                      </span>
                    </div>
                    <div class="ullm-run-output-actions">
                      <button
                        id="copy-run-output"
                        type="button"
                        phx-hook="Clipboard"
                        data-copy-value={safe_output(@run_result["output"])}
                        class="ullm-btn ullm-btn-tiny"
                      >Copy</button>
                    </div>
                  </div>
                  <div class="ullm-run-output-body">
                    <pre id="run-output" class="ullm-result-body ullm-mono"><%= safe_output(@run_result["output"]) %></pre>
                    <div :if={output_measured?(@run_result)} class="ullm-output-trace">
                      <div class="llm-trace-item">
                        <div
                          class="llm-trace-summary"
                          phx-click="toggle-ui"
                          phx-value-name="outputDetailsOpen"
                          phx-value-open={if @ui["outputDetailsOpen"], do: "false", else: "true"}
                        >
                          <div>
                            <span class="status-icon">{output_status_icon(@run_result)}</span>
                            <strong>ID: {output_trace_id(@run_result)}</strong>
                            <span
                              :if={output_model_id(@run_result, @form.params, @profiles) != ""}
                              class="llm-trace-model ullm-mono"
                              title="Model"
                            >Model: {output_model_id(@run_result, @form.params, @profiles)}</span>
                            <span
                              :if={!output_success?(@run_result)}
                              class="error-category"
                            >({output_error_category(@run_result)})</span>
                          </div>
                          <div>
                            <span>🔁 {output_attempt_count(@run_result)}</span>
                            <span>⏱️ {output_duration(@run_result)}</span>
                            <span>📥 {output_number(get_in(@run_result, ["usage", "inputTokens"]))}</span>
                            <span>↺ {output_number(output_cache_tokens(@run_result))}</span>
                            <span>📤 {output_number(get_in(@run_result, ["usage", "outputTokens"]))}</span>
                            <span :if={output_cost(@run_result)}>{output_cost(@run_result)}</span>
                            <button
                              id="output-details-toggle"
                              type="button"
                              phx-click="toggle-ui"
                              phx-value-name="outputDetailsOpen"
                              phx-value-open={
                                if @ui["outputDetailsOpen"], do: "false", else: "true"
                              }
                              aria-label={
                                if @ui["outputDetailsOpen"],
                                  do: "Hide trace details",
                                  else: "Show trace details"
                              }
                              aria-expanded={to_string(@ui["outputDetailsOpen"])}
                              disabled={@ui_save_pending?}
                            >{if @ui["outputDetailsOpen"], do: "Hide", else: "Details"}</button>
                          </div>
                        </div>
                        <div
                          :if={@ui["outputDetailsOpen"]}
                          id="output-details"
                          class="llm-trace-details"
                        >
                          <p><strong>Trace ID:</strong> {output_trace_id(@run_result)}</p>
                          <p>
                            <strong>Run ID:</strong> {output_text([@run_result["runId"]]) || "—"}
                          </p>
                          <p><strong>Status:</strong> {output_status_label(@run_result)}</p>
                          <p>
                            <strong>Used Repair:</strong> {if output_used_repair?(@run_result),
                              do: "Yes",
                              else: "No"}
                          </p>
                          <strong>Attempts:</strong>
                          <ul>
                            <li :for={attempt <- output_attempts(@run_result)}>
                              Attempt {attempt["attempt"]}: {attempt["category"]} ({attempt[
                                "statusCode"
                              ]})
                              <span :if={attempt["retryable"]}> - Retried after {attempt[
                                "delayMs"
                              ]}ms</span>
                            </li>
                          </ul>
                          <strong>Resources:</strong>
                          <div class="trace-resources">
                            <a
                              :if={output_trace_url(@run_result)}
                              href={output_trace_url(@run_result)}
                              target="_blank"
                              rel="noreferrer"
                            >View JSON Trace</a>
                            <button
                              :if={is_nil(output_trace_url(@run_result))}
                              type="button"
                              disabled
                              class="trace-resource-disabled"
                            >View JSON Trace</button>
                            <button
                              id="copy-run-curl"
                              type="button"
                              phx-hook="Clipboard"
                              data-copy-value={run_curl(@form.params, @profiles)}
                            >Copy cURL</button>
                            <button
                              id="show-run-request"
                              type="button"
                              phx-click="toggle-output-data"
                              phx-value-kind="request"
                              aria-expanded={to_string(@output_request_open?)}
                            >{if @output_request_open?, do: "Hide Request", else: "Show Request"}</button>
                            <button
                              id="show-run-response"
                              type="button"
                              phx-click="toggle-output-data"
                              phx-value-kind="response"
                              aria-expanded={to_string(@output_response_open?)}
                            >{if @output_response_open?,
                              do: "Hide Response",
                              else: "Show Response"}</button>
                          </div>
                          <div
                            :if={@output_request_open? or @output_response_open?}
                            class="trace-data-display"
                          >
                            <div
                              :if={@output_request_open?}
                              id="run-request-section"
                              class="trace-data-section"
                            >
                              <h4>Request</h4>
                              <pre id="run-request" class="trace-json ullm-mono"><%= run_request_json(@form.params, @profiles) %></pre>
                            </div>
                            <div
                              :if={@output_response_open?}
                              id="run-response-section"
                              class="trace-data-section"
                            >
                              <h4>Response</h4>
                              <pre id="run-response" class="trace-json ullm-mono"><%= safe_output(@run_result) %></pre>
                            </div>
                          </div>
                          <div
                            :if={Enum.any?(@run_result["artifacts"] || [])}
                            id="run-artifacts"
                            class="trace-resources"
                          >
                            <a
                              :for={artifact <- @run_result["artifacts"] || []}
                              href={
                                ~p"/traces/#{output_trace_id(@run_result)}/artifacts/#{artifact["artifactId"]}"
                              }
                            >{artifact["kind"]} · {artifact["sizeBytes"]} bytes</a>
                          </div>
                          <a
                            :if={output_trace_id(@run_result) != ""}
                            href={~p"/history?trace_id=#{output_trace_id(@run_result)}"}
                            target="_blank"
                            rel="noreferrer"
                          >View JSON trace in History →</a>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              </div>
            </section>

            <section
              id="workspace-history-panel"
              aria-label="History"
              class="studio-card p-4 sm:p-5"
            >
              <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h2 class="font-semibold text-slate-950">🕘 History ({length(@history)})</h2>
                  <p class="mt-1 text-xs text-slate-500">
                    Restore a prompt or inspect its redacted result.
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    :if={@history_loaded? and @history != []}
                    id="workspace-clear-history"
                    type="button"
                    phx-click="clear-history"
                    phx-confirm="Delete all history for this session? This cannot be undone."
                    disabled={not is_nil(@history_pending)}
                    class="rounded-lg border border-rose-200 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-50 disabled:opacity-50"
                  >{if @history_pending, do: "⏳ Deleting…", else: "🗑 Delete all"}</button>
                  <button
                    id="history-fold-toggle"
                    type="button"
                    phx-click="toggle-ui"
                    phx-value-name="historyOpen"
                    phx-value-open={if @ui["historyOpen"], do: "false", else: "true"}
                    aria-expanded={to_string(@ui["historyOpen"])}
                    disabled={@ui_save_pending?}
                    class="text-xs font-semibold text-teal-700 hover:text-teal-900"
                  >{if @ui["historyOpen"], do: "⌃ Hide", else: "⌄ Show"}</button>
                  <.link
                    navigate={~p"/history"}
                    class="text-sm font-medium text-teal-700 hover:text-teal-900"
                  >View all</.link>
                </div>
              </div>
              <div :if={@ui["historyOpen"]} id="workspace-history" class="space-y-2">
                <p
                  :if={@history_loading?}
                  id="workspace-history-loading"
                  role="status"
                  class="text-sm text-slate-500"
                >
                  Loading history…
                </p>
                <p
                  :if={@history_error}
                  id="workspace-history-error"
                  role="alert"
                  class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"
                >
                  {@history_error}
                </p>
                <p
                  :if={@history_loaded? and @history == [] and is_nil(@history_error)}
                  class="text-sm text-slate-500"
                >
                  No runs yet in this session.
                </p>
                <article
                  :for={item <- @history}
                  id={"workspace-history-#{item["runId"]}"}
                  class="rounded-xl bg-slate-50 p-3 text-xs"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p
                        class="truncate font-mono font-medium text-slate-800"
                        title={item["runId"]}
                      >
                        {item["runId"]}
                      </p>
                      <p class="mt-1 text-slate-500">{item["status"]} · {item["profileId"]}</p>
                      <p class="mt-1 truncate text-slate-600" title={history_prompt_preview(item)}>
                        {history_prompt_preview(item)}
                      </p>
                    </div>
                    <div class="flex shrink-0 flex-wrap justify-end gap-2">
                      <button
                        type="button"
                        phx-click="restore-history"
                        phx-value-run-id={item["runId"]}
                        disabled={not is_nil(@history_pending)}
                        class="font-semibold text-teal-700 disabled:opacity-50"
                      >Restore prompt</button>
                      <button
                        type="button"
                        phx-click="delete-history"
                        phx-value-run-id={item["runId"]}
                        disabled={not is_nil(@history_pending)}
                        class="font-semibold text-rose-700 disabled:opacity-50"
                      >Delete</button>
                      <.link
                        navigate={~p"/history?trace_id=#{item["traceId"]}"}
                        class="font-semibold text-slate-600"
                      >Inspect</.link>
                    </div>
                  </div>
                  <details class="mt-2">
                    <summary class="cursor-pointer text-slate-600">
                      Show request and result
                    </summary>
                    <pre class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-white p-2 text-[11px] text-slate-700"><%= safe_output(item["request"] || %{}) %></pre>
                    <% item_stats = history_item_stats(item) %>
                    <dl class="mt-2 grid grid-cols-2 gap-2 text-[11px] text-slate-600 sm:grid-cols-5">
                      <.history_fact label="Status" value={item["status"]} />
                      <.history_fact label="Duration ms" value={item_stats.duration} />
                      <.history_fact label="Prompt tokens" value={item_stats.input_tokens} />
                      <.history_fact label="Output tokens" value={item_stats.output_tokens} />
                      <.history_fact label="Cost" value={item_stats.cost} />
                    </dl>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <button
                        type="button"
                        id={"workspace-history-copy-result-#{item["runId"]}"}
                        phx-hook="Clipboard"
                        data-copy-value={history_result_json(item)}
                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 font-semibold text-slate-700"
                      >Copy result</button>
                      <button
                        type="button"
                        id={"workspace-history-copy-curl-#{item["runId"]}"}
                        phx-hook="Clipboard"
                        data-copy-value={history_curl(item)}
                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 font-semibold text-slate-700"
                      >Copy cURL</button>
                      <a
                        :for={artifact <- get_in(item, ["result", "artifacts"]) || []}
                        href={~p"/traces/#{item["traceId"]}/artifacts/#{artifact["artifactId"]}"}
                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 font-semibold text-teal-700"
                      >{artifact["kind"]} resource</a>
                    </div>
                    <pre class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-white p-2 text-[11px] text-slate-700"><%= safe_output(item["result"] || %{}) %></pre>
                  </details>
                </article>
              </div>
            </section>
            <% stats = stats_summary(@history) %>
            <section
              id="llm-stats-summary"
              aria-label="LLM stats"
              class="studio-card p-4 sm:p-5"
            >
              <div class="flex items-center justify-between gap-3">
                <h2 class="font-semibold text-slate-950">📊 LLM stats</h2>
                <.link navigate={~p"/history"} class="text-xs font-semibold text-teal-700">Full view</.link>
              </div>
              <dl class="mt-4 grid grid-cols-2 gap-3 text-xs sm:grid-cols-3">
                <.result_fact label="Success" value={stats.success} />
                <.result_fact label="Failed" value={stats.failed} />
                <.result_fact label="Timeout" value={stats.timeout} />
                <.result_fact label="Prompt tokens" value={stats.prompt_tokens} />
                <.result_fact label="Cache read" value={stats.cache_read_tokens} />
                <.result_fact label="Output tokens" value={stats.output_tokens} />
                <.result_fact label="Tokens" value={stats.total_tokens} />
                <.result_fact label="Known cost" value={stats.known_cost} />
                <.result_fact label="Avg duration ms" value={stats.average_duration} />
              </dl>
            </section>
          </aside>
        </section>
      </div>
    </.form>
  </main>
</Layouts.app>
