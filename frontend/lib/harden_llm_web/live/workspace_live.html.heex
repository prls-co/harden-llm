<Layouts.app flash={@flash} current_user={@current_user}>
  <main id="workspace-page" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700">Harden-LLM</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950">
          OpenAI reference workspace
        </h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600">
          Send a stateless Responses request through the hardening proxy. Signed-in users share this reference history.
        </p>
      </div>
      <span
        id="proxy-status"
        role="status"
        class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700"
      >
        {HardenLlmWeb.WorkspaceLive.status_text(@models_status)}
      </span>
    </header>

    <.form for={@form} id="run-form" phx-change="save-draft" phx-submit="run" class="space-y-6">
      <section
        aria-labelledby="request-title"
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
      >
        <div class="mb-5 flex items-center justify-between gap-3">
          <div>
            <h2 id="request-title" class="text-lg font-semibold text-slate-950">Request</h2>
            <p class="text-sm text-slate-600">Choose a native model ID and enter your prompt.</p>
          </div>
          <span :if={@draft_saving?} id="draft-saving" class="text-xs text-slate-500">Saving draft…</span>
          <span
            :if={not @draft_saving? and is_nil(@draft_error)}
            id="draft-saved"
            class="text-xs text-slate-500"
          >Draft autosaved</span>
        </div>

        <p
          :if={@draft_error}
          id="draft-error"
          role="alert"
          class="mb-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900"
        >
          {@draft_error}
        </p>
        <label for="run_model" class="mb-1 block text-sm font-medium text-slate-800">Model</label>
        <input
          id="run_model"
          name={@form[:model].name}
          list="available-models"
          value={@form[:model].value}
          autocomplete="off"
          required
          class="mb-5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
          placeholder="model ID from your configured upstream"
        />
        <datalist id="available-models">
          <option :for={model <- @models} value={model["id"]}>
            {model["name"] || model["id"]}
          </option>
        </datalist>

        <label for="run_userPrompt" class="mb-1 block text-sm font-medium text-slate-800">Prompt</label>
        <textarea
          id="run_userPrompt"
          name={@form[:userPrompt].name}
          rows="7"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
          placeholder="Ask a question or give the model a task."
        >{@form[:userPrompt].value}</textarea>

        <details class="mt-5 rounded-lg border border-slate-200 p-4">
          <summary class="cursor-pointer text-sm font-medium text-slate-800">
            Advanced request options
          </summary>
          <div class="mt-4 space-y-4">
            <div>
              <label for="run_systemPrompt" class="mb-1 block text-sm font-medium text-slate-800">Instructions</label>
              <textarea
                id="run_systemPrompt"
                name={@form[:systemPrompt].name}
                rows="3"
                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                placeholder="Optional system instructions."
              >{@form[:systemPrompt].value}</textarea>
            </div>
            <label class="flex items-center gap-2 text-sm text-slate-800">
              <input
                type="checkbox"
                name={@form[:structured].name}
                value="true"
                checked={@form[:structured].value == "true"}
                class="rounded border-slate-300"
              /> Require structured JSON output
            </label>
            <div :if={@form[:structured].value == "true"}>
              <label for="run_schema" class="mb-1 block text-sm font-medium text-slate-800">JSON Schema</label>
              <textarea
                id="run_schema"
                name={@form[:schema].name}
                rows="7"
                class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs"
                placeholder="{&quot;type&quot;:&quot;object&quot;,&quot;properties&quot;:{&quot;answer&quot;:{&quot;type&quot;:&quot;string&quot;}}}"
              >{@form[:schema].value}</textarea>
              <div class="mt-2 flex items-center gap-3">
                <button
                  id="check-schema"
                  type="button"
                  phx-click="check-schema"
                  class="rounded-md border border-slate-300 px-3 py-1.5 text-sm"
                >Check schema</button>
                <span
                  id="schema-status"
                  class={
                    if @schema_check.status == :error,
                      do: "text-sm text-rose-700",
                      else: "text-sm text-slate-600"
                  }
                >{@schema_check.message}</span>
              </div>
            </div>
            <div>
              <label
                for="run_reasoningEffort"
                class="mb-1 block text-sm font-medium text-slate-800"
              >Reasoning effort</label>
              <input
                id="run_reasoningEffort"
                name={@form[:reasoningEffort].name}
                value={@form[:reasoningEffort].value}
                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                placeholder="Optional value supported by the selected model"
              />
            </div>
            <div>
              <label for="run_recoveryJson" class="mb-1 block text-sm font-medium text-slate-800">Recovery policy JSON</label>
              <textarea
                id="run_recoveryJson"
                name={@form[:recoveryJson].name}
                rows="6"
                class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs"
                placeholder="Optional harden.recovery object"
              >{@form[:recoveryJson].value}</textarea>
              <p class="mt-1 text-xs text-slate-500">
                The proxy validates supported recovery options before dispatch.
              </p>
            </div>
          </div>
        </details>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button
            id="run-submit"
            type="submit"
            disabled={not is_nil(@run_ref) or @recording?}
            class="rounded-lg bg-teal-700 px-5 py-2.5 text-sm font-semibold text-white disabled:cursor-wait disabled:opacity-60"
          >
            {if @recording?,
              do: "Saving result…",
              else: if(is_nil(@run_ref), do: "Run request", else: "Running…")}
          </button>
          <p :if={@run_error} id="run-error" role="alert" class="text-sm text-rose-700">
            {@run_error}
          </p>
          <p
            :if={@recording_error}
            id="recording-error"
            role="status"
            class="text-sm text-amber-800"
          >
            {@recording_error}
          </p>
        </div>
      </section>
    </.form>

    <section
      :if={@run_result}
      id="run-result-panel"
      aria-label="Response"
      class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
    >
      <h2 class="mb-4 text-lg font-semibold text-slate-950">Response</h2>
      <.llm_result
        id="current-result"
        input={@run_payload && @run_payload["input"]}
        output={@run_result["output_text"] || Jason.encode!(@run_result, pretty: true)}
      >
        <:stats>
          <span :if={
            is_map(@run_result["usage"]) and is_integer(@run_result["usage"]["total_tokens"])
          }>{@run_result["usage"]["total_tokens"]} tokens</span>
          <span :if={
            not (is_map(@run_result["usage"]) and is_integer(@run_result["usage"]["total_tokens"]))
          }>Usage and cost unavailable</span>
        </:stats>
      </.llm_result>
      <details :if={@run_result["harden"]} class="mt-4 rounded-lg border border-slate-200 p-3">
        <summary class="cursor-pointer text-sm font-medium">Hardening diagnostics</summary>
        <pre id="response-diagnostics" class="mt-3 overflow-auto whitespace-pre-wrap text-xs">{Jason.encode!(@run_result["harden"], pretty: true)}</pre>
      </details>
    </section>

    <section
      id="shared-history"
      aria-labelledby="history-title"
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 id="history-title" class="text-lg font-semibold text-slate-950">Shared history</h2>
          <p class="mt-1 text-sm text-slate-600">
            Frontend requests from all enabled logins appear here. Direct API calls are not recorded.
          </p>
          <p :if={@statistics} id="history-statistics" class="mt-2 text-xs text-slate-500">
            {@statistics.total} recorded calls · {@statistics.succeeded} succeeded · {@statistics.failed} failed · {@statistics.unknown} unknown outcomes · usage and cost unavailable
          </p>
        </div>
        <button
          :if={@history.total_count > 0}
          id="clear-history"
          type="button"
          phx-click="clear-history"
          class="rounded-md border border-rose-300 px-3 py-1.5 text-sm text-rose-800"
        >Clear shared history</button>
      </div>

      <p
        :if={@history_error}
        id="history-error"
        role="status"
        class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900"
      >
        {@history_error}
      </p>
      <p
        :if={@history_loading?}
        id="history-loading"
        role="status"
        class="mt-4 text-sm text-slate-500"
      >
        Loading shared history…
      </p>
      <p
        :if={not @history_loading? and is_nil(@history_error) and @history.total_count == 0}
        id="history-empty"
        class="mt-4 text-sm text-slate-500"
      >
        No frontend calls have been recorded.
      </p>

      <div
        :if={not @history_loading? and is_nil(@history_error) and @history.items != []}
        class="mt-5 divide-y divide-slate-200"
      >
        <article
          :for={call <- @history.items}
          id={"history-#{call.id}"}
          class="py-5 first:pt-0 last:pb-0"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-sm font-medium text-slate-900">
                {call.request["model"]} · {call.outcome_kind}
              </p>
              <p class="text-xs text-slate-500">{DateTime.to_iso8601(call.inserted_at)}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                id={"restore-#{call.id}"}
                type="button"
                phx-click="restore"
                phx-value-id={call.id}
                class="rounded-md border border-slate-300 px-3 py-1.5 text-sm"
              >Restore request</button>
              <a
                id={"download-#{call.id}"}
                href={~p"/history/#{call.id}/download"}
                class="rounded-md border border-slate-300 px-3 py-1.5 text-sm"
              >Download JSON</a>
              <button
                id={"delete-#{call.id}"}
                type="button"
                phx-click="delete-call"
                phx-value-id={call.id}
                class="rounded-md border border-rose-300 px-3 py-1.5 text-sm text-rose-800"
              >Delete</button>
            </div>
          </div>
          <.llm_result
            id={"history-result-#{call.id}"}
            input={HardenLlmWeb.WorkspaceLive.call_input(call)}
            output={HardenLlmWeb.WorkspaceLive.call_output(call)}
          />
        </article>
      </div>

      <.pagination
        id="history-pagination"
        page={@history.page}
        page_size={@history.page_size}
        total_count={@history.total_count}
        show_page_size?={false}
        show_jump?={false}
        event="history-page"
        loading?={@history_loading?}
        class="mt-5 border-t border-slate-200 pt-4"
      />
    </section>
  </main>
</Layouts.app>
