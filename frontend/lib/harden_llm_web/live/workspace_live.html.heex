<Layouts.app flash={@flash} current_scope={@current_scope} current_identity={@current_identity}>
  <main id="workspace-page" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-700">
          Run workspace
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950">
          Shape one reliable call
        </h1>
      </div>
      <span
        id="backend-status"
        class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600"
      >
        {status_label(@backend_state)}
      </span>
    </div>

    <div
      :if={@loading?}
      id="workspace-loading"
      role="status"
      class="rounded-2xl border border-slate-200 bg-white p-8 text-slate-600"
    >
      Loading the canonical workspace…
    </div>

    <div
      :if={@backend_state == :unavailable}
      id="workspace-unavailable"
      role="alert"
      class="rounded-2xl border border-amber-300 bg-amber-50 p-6 text-amber-950"
    >
      The backend is unavailable. The console will remain online; refresh when the service recovers.
    </div>

    <div
      :if={@backend_state == :ready}
      class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]"
    >
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <.form
          for={@form}
          id="run-form"
          phx-change="save-draft"
          phx-submit="run"
          class="space-y-5"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <.input
              field={@form[:selectedProfileId]}
              type="select"
              label="Profile"
              prompt="Choose a profile"
              options={profile_options(@profiles)}
              required
            />
            <.input
              field={@form[:modelId]}
              type="text"
              label="Model override"
              placeholder="Use profile default"
            />
          </div>
          <.input
            field={@form[:systemPrompt]}
            type="textarea"
            label="System prompt (optional)"
            rows="3"
          />
          <.input field={@form[:userPrompt]} type="textarea" label="Prompt" rows="8" required />
          <div class="grid gap-4 sm:grid-cols-3">
            <.input
              field={@form[:callType]}
              type="select"
              label="Response type"
              options={[{"Text", "text"}, {"Structured JSON", "structured"}]}
            />
            <.input
              field={@form[:cacheMode]}
              type="select"
              label="Cache"
              options={[{"Off", "off"}, {"Use cache", "cache"}, {"Refresh", "refresh"}]}
            />
            <.input field={@form[:structuredRepair]} type="checkbox" label="Allow one repair" />
          </div>
          <.input
            field={@form[:schema]}
            type="textarea"
            label="JSON Schema (structured calls)"
            rows="6"
          />
          <div
            :if={@run_error}
            id="run-error"
            role="alert"
            class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900"
          >
            {@run_error}
          </div>
          <button
            id="run-submit"
            type="submit"
            disabled={not is_nil(@run_ref)}
            phx-disable-with="Running…"
            class="inline-flex items-center gap-2 rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:ring-offset-2 disabled:cursor-wait disabled:opacity-50"
          >
            <.icon name="hero-play" class="size-4" />
            <span>{if @run_ref, do: "Running…", else: "Run once"}</span>
          </button>
        </.form>
      </section>

      <aside class="space-y-6">
        <section
          id="run-result-panel"
          class="min-h-64 rounded-2xl border border-slate-200 bg-slate-950 p-5 text-slate-100 shadow-sm"
        >
          <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">
            Latest result
          </h2>
          <div :if={is_nil(@run_result)} class="mt-8 text-sm leading-6 text-slate-400">
            A successful run will show its redacted output, usage, cost, attempts, cache facts, and correlation IDs here.
          </div>
          <div :if={@run_result} class="mt-5 space-y-5">
            <pre
              id="run-output"
              class="max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-slate-900 p-4 text-sm"
            ><%= safe_output(@run_result["output"]) %></pre>
            <dl class="grid grid-cols-2 gap-3 text-xs">
              <.result_fact label="Run ID" value={@run_result["runId"]} />
              <.result_fact label="Trace ID" value={@run_result["traceId"]} />
              <.result_fact label="Tokens" value={get_in(@run_result, ["usage", "totalTokens"])} />
              <.result_fact label="Cost USD" value={get_in(@run_result, ["cost", "totalUsd"])} />
              <.result_fact label="Attempts" value={length(@run_result["attempts"] || [])} />
              <.result_fact label="Cache" value={get_in(@run_result, ["cache", "status"])} />
            </dl>
          </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-5">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-semibold text-slate-950">Recent history</h2>
            <.link
              navigate={~p"/history"}
              class="text-sm font-medium text-teal-700 hover:text-teal-900"
            >View all</.link>
          </div>
          <div id="workspace-history" class="space-y-2">
            <p :if={@history == []} class="text-sm text-slate-500">No runs yet.</p>
            <div
              :for={item <- @history}
              id={"workspace-history-#{item["runId"]}"}
              class="rounded-xl bg-slate-50 p-3 text-xs"
            >
              <p class="truncate font-medium text-slate-800" title={item["runId"]}>
                {item["runId"]}
              </p>
              <p class="mt-1 text-slate-500">{item["status"]} · {item["profileId"]}</p>
            </div>
          </div>
        </section>
      </aside>
    </div>
  </main>
</Layouts.app>
