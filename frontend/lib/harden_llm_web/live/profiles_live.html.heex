<Layouts.app flash={@flash} current_scope={@current_scope} current_identity={@current_identity}>
  <main id="profiles-page" class="studio-page mx-auto max-w-5xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-700">
          ⚙ Configuration
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950">Profiles</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-600">
          Configure endpoints, model interfaces, provider options, recovery, pricing, and credentials.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          id="export-bundle"
          href={~p"/profiles/bundle"}
          class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-teal-600"
        >
          📤 Export bundle
        </a>
        <button
          id="new-profile"
          type="button"
          phx-click="new"
          aria-controls="profile-editor"
          aria-expanded={to_string(@editing?)}
          class="inline-flex items-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
        >
          ➕ New profile
        </button>
      </div>
    </div>

    <div
      :if={@operation_error}
      id="profiles-error"
      role="alert"
      class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900"
    >
      {@operation_error}
    </div>

    <section class="studio-card mb-6 p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-semibold text-slate-950">📥 Import encrypted bundle</h2>
          <p class="mt-1 text-xs text-slate-500">
            JSON only, at most 2 MiB. The file is sent once and never persisted here.
          </p>
        </div>
        <form
          id="bundle-import-form"
          phx-submit="import-bundle"
          phx-change="validate-bundle"
          class="flex flex-wrap items-center gap-2"
        >
          <label for={@uploads.bundle.ref} class="sr-only">Encrypted profile bundle JSON</label>
          <.live_file_input
            upload={@uploads.bundle}
            id="bundle-import-file"
            class="max-w-64 text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-xs file:font-semibold"
          />
          <button
            id="bundle-import-submit"
            type="submit"
            class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold hover:bg-slate-50"
          >Import</button>
        </form>
      </div>
      <p :for={error <- upload_errors(@uploads.bundle)} class="mt-2 text-xs text-rose-700">
        {Phoenix.Naming.humanize(error)}
      </p>
    </section>

    <section
      aria-labelledby="profile-catalog-title"
      class="studio-card min-w-0 max-w-full overflow-hidden p-3 sm:p-4"
    >
      <div class="mb-3 border-b border-slate-200 px-1 pb-3">
        <h2 id="profile-catalog-title" class="font-semibold text-slate-950">Profile catalog</h2>
        <p id="profile-presets-help" class="mt-1 max-w-3xl text-xs text-slate-500">
          The workspace picker uses this same backend-owned catalog. Built-in utility-llm presets appear alongside custom profiles; add a credential before running one.
        </p>
      </div>
      <div :if={@loading?} id="profiles-loading" role="status" class="p-8 text-sm text-slate-500">
        Loading profiles…
      </div>
      <div id="profiles" phx-update="stream" class="divide-y divide-slate-200">
        <div
          id="profiles-empty"
          class="hidden only:block py-10 text-center text-sm text-slate-500"
        >
          No profiles available.
        </div>
        <article
          :for={{dom_id, profile_state} <- @streams.profiles}
          id={dom_id}
          class="py-3 first:pt-0 last:pb-0"
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h2
                class="break-words font-semibold text-slate-950"
                title={profile_state["profile"]["llmProfile"]}
              >
                🤖 {profile_state["profile"]["llmProfile"]}
              </h2>
              <p class="mt-1 text-xs text-slate-500">
                {profile_state["profile"]["provider"]} · {profile_state["profile"][
                  "apiInferenceType"
                ]}
              </p>
            </div>
            <div class="flex shrink-0 gap-1">
              <button
                id={"refresh-profile-#{profile_state["profile"]["llmProfile"]}"}
                type="button"
                phx-click="refresh"
                phx-value-id={profile_state["profile"]["llmProfile"]}
                title="Refresh models"
                aria-label="Refresh models"
                class="studio-emoji-control rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
              >🔄</button>
              <button
                id={"edit-profile-#{profile_state["profile"]["llmProfile"]}"}
                type="button"
                phx-click="edit"
                phx-value-id={profile_state["profile"]["llmProfile"]}
                title="Edit profile"
                aria-label="Edit profile"
                class="studio-emoji-control rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-teal-600"
              >⚙</button>
              <button
                id={"delete-profile-#{profile_state["profile"]["llmProfile"]}"}
                type="button"
                phx-click="confirm-delete"
                phx-value-id={profile_state["profile"]["llmProfile"]}
                title="Delete profile"
                aria-label="Delete profile"
                class="studio-emoji-control rounded-lg p-2 text-slate-500 hover:bg-rose-50 hover:text-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-600"
              >🗑</button>
            </div>
          </div>
          <dl class="mt-3 grid gap-2 text-xs text-slate-600 sm:grid-cols-2 lg:grid-cols-4">
            <div class="min-w-0">
              <dt class="text-slate-400">Endpoint</dt>
              <dd class="mt-0.5 truncate font-mono" title={profile_host(profile_state)}>
                {profile_host(profile_state)}
              </dd>
            </div>
            <div>
              <dt class="text-slate-400">Credential</dt>
              <dd class="mt-0.5">
                {if profile_state["credential"]["configured"],
                  do: "🔐 Configured",
                  else: "⚠ Not configured"}
              </dd>
            </div>
            <div>
              <dt class="text-slate-400">Models</dt>
              <dd class="mt-0.5">{models_count(profile_state)} available</dd>
            </div>
          </dl>
        </article>
      </div>
    </section>

    <section
      :if={@editing?}
      id="profile-editor"
      aria-labelledby="profile-editor-title"
      class="studio-card mt-6 p-4 sm:p-6"
    >
      <div class="mb-5 flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">
            🧩 LLM profile
          </p>
          <h2 id="profile-editor-title" class="mt-1 text-xl font-semibold text-slate-950">
            Profile configuration
          </h2>
          <p class="mt-1 text-xs text-slate-500">
            This is the same complete LLM profile widget used by the workspace and embedding surfaces.
          </p>
        </div>
        <button
          id="profile-editor-close"
          type="button"
          phx-click="cancel-edit"
          aria-label="Close profile editor"
          class="studio-emoji-control rounded-lg p-2 text-slate-500 hover:bg-slate-100"
        >✕</button>
      </div>
      <.form
        for={@form}
        id="profile-form"
        phx-change="draft-change"
        phx-submit="save"
        class="studio-stack"
      >
        <.live_component
          module={HardenLlmWeb.ProfileWidgetComponent}
          id="profile-definition-widget"
          id_prefix="profile"
          host_context="profile_definition"
          profiles={Map.values(@profiles_by_id)}
          selected_profile_id={@form.params["profileId"] || ""}
          model_id={@form.params["modelId"] || ""}
          model_catalog={nil}
          model_options={model_options(@profiles_by_id, @form.params["profileId"] || "")}
          config_open={true}
          credential_open={@credential_open}
          options_open={@options_open}
          retry_open={@retry_open}
          recovery_policy={@form.params["recoveryPolicy"] || %{}}
          recovery_policy_default={@recovery_policy_default}
          pricing_open={@pricing_open}
          fold_disabled={false}
          session_handle={@session_handle}
          field_errors={@field_errors}
          definition_form={@form}
          definition_revision={@editor_form_revision}
        />
      </.form>
    </section>

    <section
      :if={@delete_id}
      id="profile-delete-panel"
      role="alert"
      aria-labelledby="profile-delete-title"
      aria-describedby="profile-delete-description"
      class="studio-card mt-6 border-rose-200 bg-rose-50 p-4 sm:p-5"
    >
      <h2 id="profile-delete-title" class="text-lg font-semibold text-slate-950">
        🗑 Delete profile?
      </h2>
      <p id="profile-delete-description" class="mt-2 break-words text-sm text-slate-600">
        Delete <strong>{@delete_id}</strong> from your profile catalog.
      </p>
      <div class="mt-5 flex flex-wrap justify-end gap-2">
        <button
          id="profile-delete-cancel"
          type="button"
          phx-click="cancel-delete"
          class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold"
        >✕ Cancel</button>
        <button
          id="profile-delete-confirm"
          type="button"
          phx-click="delete"
          class="rounded-xl bg-rose-700 px-4 py-2 text-sm font-semibold text-white"
        >🗑 Delete</button>
      </div>
    </section>
  </main>
</Layouts.app>
