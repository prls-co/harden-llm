<Layouts.app flash={@flash} current_scope={nil}>
  <main id="login-page" class="mx-auto flex min-h-[70vh] max-w-md items-center px-5 py-12">
    <section class="w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-950/5">
      <div class="mb-8">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">
          Harden LLM
        </p>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950">Operational console</h1>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Sign in with your local operator account. Provider credentials never enter this browser.
        </p>
      </div>

      <.form for={@form} id="login-form" action={~p"/login"} class="space-y-5">
        <.input
          field={@form[:email]}
          type="email"
          label="Email address"
          autocomplete="username"
          required
        />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          minlength="12"
          required
        />
        <button
          id="login-submit"
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-xl bg-slate-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:ring-offset-2 disabled:cursor-wait disabled:opacity-60"
        >
          Sign in
        </button>
      </.form>
    </section>
  </main>
</Layouts.app>
