# Copy to .env and replace every required placeholder with independently generated values.
# Shared provider/model setup: docs/shared-llm-configuration.md.
# Profile catalog and credential-variable references belong in a JSON file.
HARDEN_LLM_CONFIG_FILE=/absolute/path/to/config/llm-profiles.local.json
# Referenced keys belong in separate *_API_KEY variables, never profile JSON or Git.
HARDEN_LLM_API_HOST=api.example.net
HARDEN_LLM_WEB_HOST=app.example.net
HARDEN_LLM_GRAFANA_HOST=grafana.example.net
HARDEN_LLM_ARTIFACT_EXTERNAL_ENDPOINT=https://artifacts.example.net
HARDEN_LLM_RELEASE=0.1.0
HARDEN_LLM_ENVIRONMENT=production
HARDEN_LLM_WEB_SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
HARDEN_LLM_WEB_SESSION_SIGNING_SALT=replace-with-random-signing-salt
HARDEN_LLM_WEB_SESSION_ENCRYPTION_SALT=replace-with-random-encryption-salt
HARDEN_LLM_WEB_INSTANCE_ID=harden-llm-web-1
HARDEN_LLM_WEB_API_TIMEOUT_MS=15000
HARDEN_LLM_WEB_RUN_TIMEOUT_MS=65000
HARDEN_LLM_WEB_LOG_MAX_BYTES=10485760
HARDEN_LLM_WEB_LOG_MAX_FILES=5
HARDEN_LLM_POSTGRES_PASSWORD=replace-with-url-safe-random-value
HARDEN_LLM_ENCRYPTION_KEYS={"primary":"replace-with-base64url-encoded-32-byte-key"}
HARDEN_LLM_ACTIVE_ENCRYPTION_KEY_ID=primary
HARDEN_LLM_ARTIFACT_BUCKET=harden-llm-artifacts
HARDEN_LLM_ARTIFACT_ACCESS_KEY_ID=replace-with-garage-access-key
HARDEN_LLM_ARTIFACT_SECRET_ACCESS_KEY=replace-with-garage-secret-key
PRLS_LOKI_S3_ACCESS_KEY=replace-with-dedicated-prls-loki-garage-access-key
PRLS_LOKI_S3_SECRET_KEY=replace-with-dedicated-prls-loki-garage-secret-key
HARDEN_LLM_ARTIFACT_PRESIGN_TTL=1m
# Required gateway/frontend service credential. Store it in the ignored .env.
HARDEN_LLM_STATIC_TOKEN=replace-with-at-least-32-random-printable-bytes
# Control Plane is the source of enabled human identities and sessions.
HARDEN_LLM_CONTROL_PLANE_URL=http://control-plane:4310
HARDEN_LLM_CONTROL_PLANE_INTERNAL_TOKEN=replace-with-control-plane-internal-token
# Optional user scope for direct machine API requests using the service credential.
# HARDEN_LLM_STATIC_TOKEN_USER_ID=verification-user
# Explicit Control Plane user IDs for trusted shared-profile synchronization.
# HARDEN_LLM_PROFILE_USER_IDS=verification-user
# Optional Jina Search API key for web-search fallback runs. Keep it in the ignored .env.
# JINA_API_KEY=replace-with-jina-api-key
HARDEN_LLM_MAX_RUN_DURATION_MS=60000
HARDEN_LLM_PROVIDER_ALLOWED_HOSTS=
HARDEN_LLM_PROVIDER_PRIVATE_ALLOWLIST=
HARDEN_LLM_METRICS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
PRLS_LAMINAR_PROJECT_API_KEY=replace-with-prls-laminar-project-key
HARDEN_LLM_LAMINAR_PROJECT_API_KEY=replace-with-harden-llm-laminar-ingest-key
# Keep the production exporter pointed at the shared Laminar service.
HARDEN_LLM_LAMINAR_ENDPOINT=laminar:8001

PRLS_PORTAL_URL=
HARDEN_LLM_WEB_PUBLIC_URL=
