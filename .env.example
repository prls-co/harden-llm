# Copy to .env and replace the required values with the approved deployment secrets.
# Provider routing is connection-only JSON; API credentials stay in this file.
HARDEN_LLM_CONFIG_FILE=/absolute/path/to/config/upstreams.local.json
HARDEN_LLM_TOKEN=replace-with-at-least-32-random-printable-bytes
CPA_API_KEY=replace-with-cpa-api-key

HARDEN_LLM_WEB_HOST=app.example.net
HARDEN_LLM_GRAFANA_HOST=grafana.example.net
HARDEN_LLM_RELEASE=0.1.0
HARDEN_LLM_ENVIRONMENT=production
HARDEN_LLM_WEB_SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
HARDEN_LLM_WEB_SESSION_SIGNING_SALT=replace-with-random-signing-salt
HARDEN_LLM_WEB_SESSION_ENCRYPTION_SALT=replace-with-random-encryption-salt
HARDEN_LLM_WEB_INSTANCE_ID=harden-llm-web-1
HARDEN_LLM_WEB_API_TIMEOUT_MS=75000
HARDEN_LLM_WEB_LOG_MAX_BYTES=10485760
HARDEN_LLM_WEB_LOG_MAX_FILES=5

# Human identity and access remain owned by Control Plane and Portal.
HARDEN_LLM_CONTROL_PLANE_URL=http://control-plane:4310
HARDEN_LLM_CONTROL_PLANE_INTERNAL_TOKEN=replace-with-control-plane-internal-token
PRLS_PORTAL_URL=https://portal.prls.co

# Optional web-search fallback key. CPA-native web search does not use it.
# JINA_API_KEY=replace-with-jina-api-key
HARDEN_LLM_MAX_RUN_DURATION_MS=60000
HARDEN_LLM_PROVIDER_ALLOWED_HOSTS=
HARDEN_LLM_PROVIDER_PRIVATE_ALLOWLIST=
HARDEN_LLM_METRICS_RETENTION=30d

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
PRLS_LOKI_S3_ACCESS_KEY=replace-with-dedicated-prls-loki-garage-access-key
PRLS_LOKI_S3_SECRET_KEY=replace-with-dedicated-prls-loki-garage-secret-key
PRLS_LAMINAR_PROJECT_API_KEY=replace-with-prls-laminar-project-key
HARDEN_LLM_LAMINAR_PROJECT_API_KEY=replace-with-harden-llm-laminar-ingest-key
HARDEN_LLM_LAMINAR_ENDPOINT=laminar:8001

HARDEN_LLM_WEB_PUBLIC_URL=

# Shared PostgreSQL is owned by Agent Platform; the Go gateway owns HLLM rows.
HARDEN_LLM_DATABASE_URL=postgresql://harden_llm:replace-with-approved-db-password@postgres:5432/harden_llm
HARDEN_LLM_POSTGRES_NETWORK=replace-with-shared-database-owner-network
HARDEN_LLM_DATABASE_POOL_SIZE=10
HARDEN_LLM_HISTORY_ENABLED=true
HARDEN_LLM_CACHE_TTL_SECONDS=86400
# Generate once with openssl rand -base64 32; preserve and back up with the environment.
HARDEN_LLM_CREDENTIAL_KEY=replace-with-standard-base64-of-32-bytes
# Production requires all four artifact settings. Previews leave them unset.
HARDEN_LLM_ARTIFACT_ENDPOINT=http://garage:3900
HARDEN_LLM_ARTIFACT_BUCKET=harden-llm-artifacts
HARDEN_LLM_ARTIFACT_ACCESS_KEY_ID=replace-with-approved-garage-access-key
HARDEN_LLM_ARTIFACT_SECRET_ACCESS_KEY=replace-with-approved-garage-secret-key
